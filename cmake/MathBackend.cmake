# ASTER 全库的数学入口和浮点构建规则，第三方实现源码保持原样。
set(ASTER_MATH_BACKEND "OPENLIBM" CACHE STRING "ASTER math backend: OPENLIBM or SYSTEM")
set_property(CACHE ASTER_MATH_BACKEND PROPERTY STRINGS OPENLIBM SYSTEM)
if(NOT ASTER_MATH_BACKEND MATCHES "^(OPENLIBM|SYSTEM)$")
    message(FATAL_ERROR "ASTER_MATH_BACKEND must be OPENLIBM or SYSTEM")
endif()

add_library(aster_math_backend_rules INTERFACE)
set(ASTER_MATH_OPENLIBM 0)
set(ASTER_MATH_DESCRIPTION "backend=SYSTEM; fp=toolchain-default; Eigen=3.4.0")
if(ASTER_MATH_BACKEND STREQUAL "OPENLIBM")
    if(NOT UNIX OR NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
        message(FATAL_ERROR "OPENLIBM backend currently supports Unix with Clang or GNU")
    endif()
    function(aster_add_openlibm)
        set(BUILD_SHARED_LIBS ON)
        add_subdirectory(third_party/openlibm EXCLUDE_FROM_ALL)
    endfunction()
    aster_add_openlibm()
    set_target_properties(openlibm PROPERTIES LIBRARY_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/bin")
    # ELF 库内调用固定在 OpenLibm 内，防止回到可执行文件的数学入口。
    if(UNIX AND NOT APPLE)
        target_link_options(openlibm PRIVATE -Wl,-Bsymbolic-functions)
    endif()
    set(ASTER_MATH_OPENLIBM 1)
    set(ASTER_MATH_DESCRIPTION "backend=OPENLIBM-0.8.8; fp=no-fast-math,contract-off; Eigen=3.4.0,scalar; builtin=sin/cos-off")
    target_compile_options(aster_math_backend_rules INTERFACE
        -fno-builtin-sin -fno-builtin-cos -fno-fast-math -ffp-contract=off)
    target_compile_definitions(aster_math_backend_rules INTERFACE
        $<$<COMPILE_LANGUAGE:CXX>:EIGEN_DONT_VECTORIZE>)
endif()
# 消除日志 __FILE__ 中的本机源码路径，两种后端采用相同规则。
if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    target_compile_options(aster_math_backend_rules INTERFACE "-ffile-prefix-map=${PROJECT_SOURCE_DIR}=.")
endif()
configure_file(cmake/math_backend_config.hpp.in generated/math_backend_config.hpp @ONLY)
add_library(aster_math_backend_impl OBJECT src/math_backend.cpp)
target_compile_definitions(aster_math_backend_impl PRIVATE ASTER_MATH_BUILD_TYPE="$<CONFIG>")
target_include_directories(aster_math_backend_impl PRIVATE include "${PROJECT_BINARY_DIR}/generated")
target_link_libraries(aster_math_backend_impl PRIVATE aster_math_backend_rules)
if(ASTER_MATH_OPENLIBM)
    target_compile_definitions(aster_math_backend_impl PRIVATE ASTER_OPENLIBM_NAME="$<TARGET_FILE_NAME:openlibm>")
    add_dependencies(aster_math_backend_impl openlibm)
endif()
add_library(aster_math_backend INTERFACE)
add_library(ASTER::math_backend ALIAS aster_math_backend)
target_include_directories(aster_math_backend INTERFACE "${PROJECT_SOURCE_DIR}/include" "${PROJECT_BINARY_DIR}/generated")
# 显式传播对象，避免静态归档按需提取遗漏标准数学入口。
target_link_libraries(aster_math_backend INTERFACE aster_math_backend_rules
    aster_math_backend_impl $<TARGET_OBJECTS:aster_math_backend_impl> ${CMAKE_DL_LIBS})
message(STATUS "ASTER ${ASTER_MATH_DESCRIPTION}")
