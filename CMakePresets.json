{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "gcrs-tt-check",
      "binaryDir": "${sourceDir}/build/client",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "ASTER_MATH_BACKEND": "SYSTEM"
      }
    },
    {
      "name": "gcrs-tt-check-windows",
      "inherits": "gcrs-tt-check",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 3
    },
    {
      "name": "gcrs-tt-check",
      "configurePreset": "gcrs-tt-check",
      "configuration": "Release",
      "targets": [
        "aster_opn_gcrs_tt_check"
      ]
    },
    {
      "name": "gcrs-tt-check-windows",
      "configurePreset": "gcrs-tt-check-windows",
      "configuration": "Release",
      "targets": [
        "aster_opn_gcrs_tt_check"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^(core_|math_backend_sofa|invalid_inputs|data_integrity|iod_batch_handoff|observation_|cislunar_|gravity_conventions|station_coordinates_|conversion_roundtrips)"
        }
      }
    }
  ]
}
